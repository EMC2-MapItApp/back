# PostgreSQL DSN (can be full URI)
# Example: postgresql://postgres:password@localhost:5432/mapit_db
PG_DSN=postgresql://postgres:win98se@localhost:5432/mapit_db

# MongoDB connection (Atlas recommended)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URI=
MONGODB_DATABASE=mapit_db

# Optional migration controls
MIGRATION_BATCH_SIZE=500

# SMTP (envio del correo de verificacion de cuenta, Fase 1 auth)
# Un Gmail App Password gratuito sirve para probar en local
MAPIT_SMTP_HOST=smtp.gmail.com
MAPIT_SMTP_PORT=587
MAPIT_SMTP_USERNAME=
MAPIT_SMTP_PASSWORD=
MAPIT_MAIL_FROM=no-reply@mapit.local

# URL publica del frontend, usada para construir el enlace del correo de verificacion
MAPIT_FRONTEND_URL=http://localhost:4200