# PostgreSQL DSN (can be full URI)
# Example: postgresql://postgres:password@localhost:5432/mapit_db
PG_DSN=postgresql://postgres:win98se@localhost:5432/mapit_db

# MongoDB connection (Atlas recommended)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URI=
MONGODB_DATABASE=mapit_db

# Optional migration controls
MIGRATION_BATCH_SIZE=500