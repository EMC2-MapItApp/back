<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>emc.mapIt</groupId>
	<artifactId>mapIt</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>war</packaging>
	<name>mapIt</name>
	<description>Backend REST de MapIt, una plataforma de eventos y lugares locales geolocalizados.</description>
	<url>https://github.com/EMC2-MapItApp/back</url>
	<licenses>
		<license>
			<name>PolyForm Noncommercial License 1.0.0</name>
			<url>https://polyformproject.org/licenses/noncommercial/1.0.0</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<name>Eusebio Montero</name>
			<url>https://github.com/EMC2-MapItApp</url>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/EMC2-MapItApp/back.git</connection>
		<developerConnection>scm:git:https://github.com/EMC2-MapItApp/back.git</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/EMC2-MapItApp/back</url>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>

	<profiles>

		<!-- ══════════════════════════════════════════════════
         PERFIL: dev
         Uso: mvn package -P dev
         → Empaqueta como WAR para desplegar en Tomcat externo.
         → Tomcat se marca como "provided" porque el contenedor
           lo proporciona (no se embebe en el artefacto).
         ══════════════════════════════════════════════════ -->
		<profile>
			<id>dev</id>
			<activation>
				<!-- Activo por defecto si no se especifica perfil -->
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<!-- Spring activará application-dev.yaml en runtime -->
				<spring.profiles.active>dev</spring.profiles.active>
			</properties>
			<dependencies>
				<dependency>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-tomcat</artifactId>
					<scope>provided</scope>
				</dependency>
			</dependencies>
		</profile>

		<!-- ══════════════════════════════════════════════════
         PERFIL: prod
         Uso: mvn package -P prod  (o por defecto en CI)
         → Empaqueta como JAR self-contained para Docker.
         → Tomcat embedded activo (viene de spring-boot-starter-web).
         → No modifica dependencias: hereda el pom base.
         ══════════════════════════════════════════════════ -->
		<profile>
			<id>prod</id>
			<properties>
				<!-- Activa application-prod.yaml en runtime (nombre usado en Cloud Run) -->
				<spring.profiles.active>prod</spring.profiles.active>
			</properties>
		</profile>

	</profiles>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-json</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- MongoDB -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-mongodb</artifactId>
		</dependency>

		<!-- Envio de email (verificacion de cuenta, Fase 1 auth) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- Puerto Java del algoritmo zxcvbn (misma escala 0-4 que el zxcvbn-ts del frontend) -->
		<dependency>
			<groupId>com.nulab-inc</groupId>
			<artifactId>zxcvbn</artifactId>
			<version>1.9.0</version>
		</dependency>

		<!-- Rate limiting en memoria (RateLimitFilter) para /auth/login y /auth/forgot-password.
		     Solo bucket4j-core: sin backend distribuido (Redis/Hazelcast) porque Cloud Run corre
		     hoy con una sola instancia — si se escala a varias réplicas, los contadores dejan de
		     ser exactos entre instancias y hay que revisar esto. -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j-core</artifactId>
			<version>8.10.1</version>
		</dependency>

		<!-- Protocolo Web Push (VAPID) para notificaciones nativas del SO (notifications/) -->
		<dependency>
			<groupId>nl.martijndwars</groupId>
			<artifactId>web-push</artifactId>
			<version>5.1.2</version>
		</dependency>
		<!-- web-push declara httpcore/bouncycastle en scope runtime; el adaptador WebPushSender
		     referencia sus tipos (HttpResponse, BouncyCastleProvider) directamente, así que hacen
		     falta en compile. -->
		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpcore</artifactId>
			<version>4.4.16</version>
		</dependency>
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<version>1.78.1</version>
		</dependency>
		<!-- Requerida en compile-time por nl.martijndwars:web-push: PushService.send() referencia
		     org.jose4j.lang.JoseException en su firma, aunque este repo no la use directamente
		     (confirmado con `mvn clean compile` fallando sin esta dependencia explícita). -->
		<dependency>
			<groupId>org.bitbucket.b_c</groupId>
			<artifactId>jose4j</artifactId>
			<version>0.7.9</version>
		</dependency>

		<!-- Source: https://mvnrepository.com/artifact/org.projectlombok/lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.42</version>
			<scope>compile</scope>
		</dependency>


	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>1.18.42</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>